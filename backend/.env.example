# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/varlikent

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Owner notification email
OWNER_EMAIL=owner@varlikent.com

# Server
PORT=5000

# The production website origin. Used by BOTH the Express CORS middleware and
# the Socket.IO handshake CORS check — they are configured separately, so the
# shared allowlist lives in config/origins.js.
#
# Must match the browser's origin EXACTLY, including the www: vercel.json
# redirects varlikent.com to www.varlikent.com, so the origin a production
# browser actually sends is https://www.varlikent.com
FRONTEND_URL=http://localhost:5173

# Optional. Additional allowed browser origins, comma-separated — e.g. a Vercel
# preview deployment or a second domain. http://localhost:5173 and
# http://127.0.0.1:5173 are ALWAYS allowed and do not need listing here.
# EXTRA_CORS_ORIGINS=https://staging.varlikent.com

# Google Sign-In — REQUIRED. /api/auth/google returns 500 without it.
#
# The OAuth client ID of the Varlikent WEBSITE, from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application).
# It must be the SAME value the frontend builds with as VITE_GOOGLE_CLIENT_ID:
# the browser obtains a Google access token using that client, and the backend
# refuses any token whose `aud` is not on this allowlist. If the two drift
# apart, every Google login fails with "Google authentication failed".
#
# Client IDs are public — the website serves this one to every visitor — so
# this is not a secret. It is configuration because the trusted client differs
# between environments, not because it needs hiding.
GOOGLE_CLIENT_ID=

# Optional. Additional trusted Google OAuth client IDs, comma-separated.
#
# Google issues a separate client ID per platform, so when the mobile apps get
# their own Android and iOS OAuth clients, list them here — a mobile sign-in
# presents a token whose `aud` is the platform's client, not the website's.
# Leave unset until those clients actually exist in Google Cloud; a placeholder
# would sit in the allowlist matching nothing.
# GOOGLE_CLIENT_IDS=<android-client-id>,<ios-client-id>

# OAuth (future)
APPLE_CLIENT_ID=
MS_CLIENT_ID=
