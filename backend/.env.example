# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/varlikent

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Deployment name, used ONLY to separate Design My Space room photos in
# Cloudinary: varlikent/<VARLIKENT_ENV>/design-room-photos/<photoId>.
# Set it explicitly on Render (e.g. production) — Render does not set NODE_ENV.
# Falls back to NODE_ENV, then 'development'. Local development and production
# may share one Cloudinary cloud; this keeps their private photos apart.
# VARLIKENT_ENV=production

# ── Design My Space room visualizations ─────────────────────────────────
#
# The image model that turns a room photo plus the user's design choices into
# a redesigned room. Server-side only: the mobile app never sees a key, an
# account id, a prompt or a storage id.
#
# One of two providers runs, chosen by DESIGN_GENERATION_PROVIDER. Both take
# the same prompt, feed the same result pipeline and produce the same private
# Cloudinary asset — only the credentials differ.
#
#   DESIGN_GENERATION_PROVIDER=gemini        the default
#   DESIGN_GENERATION_PROVIDER=cloudflare
#   DESIGN_GENERATION_PROVIDER=none          disables generation entirely
#
# ── gemini ──────────────────────────────────────────────────────────────
# Uses GEMINI_API_KEY (already required by the chatbot and the listing
# assistant). IMPORTANT: Gemini IMAGE models have no free tier, so that key
# must be on a paid plan or every generation fails with PROVIDER_FAILED.
# Generated images carry Google's invisible SynthID watermark.
#   DESIGN_GENERATION_MODEL=gemini-3.1-flash-image
#   DESIGN_GENERATION_IMAGE_SIZE=1K          1K | 2K | 4K (cost rises with size)
#
# ── cloudflare (Workers AI) ─────────────────────────────────────────────
# Both of these are required, and both are server-side only. The token can
# spend money on your account, so it must never reach the website bundle or
# the mobile app — in particular, never as an EXPO_PUBLIC_ variable.
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_workers_ai_token
#
#   CLOUDFLARE_DESIGN_MODEL=@cf/black-forest-labs/flux-2-klein-4b
#   CLOUDFLARE_DESIGN_INPUT_MAX_EDGE=500     Cloudflare requires every input
#                                            image to be SMALLER than 512x512,
#                                            so this is capped at 511. The
#                                            adapter downscales a throwaway
#                                            copy; the stored room photo is
#                                            never modified.
#   CLOUDFLARE_DESIGN_OUTPUT_MAX_EDGE=1024   long edge asked of the model
#
# ── both ────────────────────────────────────────────────────────────────
#   DESIGN_GENERATION_WORKER_ENABLED=true    'false' = serve HTTP only
#   DESIGN_GENERATION_WORKER_CONCURRENCY=1   jobs at once in this process
#
# Creating a visualization ALSO requires the designGenerationsEnabled site
# setting (SiteSettings, default false) — see PUT /api/settings.
#
# One real, billable Cloudflare call, never run by the test suite:
#   CLOUDFLARE_LIVE_TEST=yes-spend-quota node scripts/liveCloudflareDesignGeneration.js ./room.jpg

# Email — Resend HTTPS API
#
# Delivery moved off SMTP deliberately. Render's free web services block
# outbound SMTP (ports 25 / 465 / 587), so Nodemailer to smtp.gmail.com timed
# out in production while working fine locally. Resend is reached over HTTPS on
# 443, which is not blocked. EMAIL_HOST / EMAIL_PORT / EMAIL_USER / EMAIL_PASS
# are no longer read by any code and can be deleted from the environment.
#
# Server-side only. This key can send mail as your verified domain, so it must
# never reach the website bundle or the mobile app.
RESEND_API_KEY=your_resend_api_key
#
# The sender, which must be on a domain verified in Resend. The friendly-name
# form is what recipients see. Kept in the environment so the verified domain
# can be chosen without a code change.
EMAIL_FROM=Varlikent <no-reply@your_verified_domain>

# Owner notification email
OWNER_EMAIL=owner@varlikent.com

# Server
PORT=5000

# The production website origin. Used by BOTH the Express CORS middleware and
# the Socket.IO handshake CORS check — they are configured separately, so the
# shared allowlist lives in config/origins.js.
#
# Must match the browser's origin EXACTLY, including the www: vercel.json
# redirects varlikent.com to www.varlikent.com, so the origin a production
# browser actually sends is https://www.varlikent.com
FRONTEND_URL=http://localhost:5173

# Optional. Additional allowed browser origins, comma-separated — e.g. a Vercel
# preview deployment or a second domain. http://localhost:5173 and
# http://127.0.0.1:5173 are ALWAYS allowed and do not need listing here.
# EXTRA_CORS_ORIGINS=https://staging.varlikent.com

# Google Sign-In — REQUIRED. /api/auth/google returns 500 without it.
#
# The OAuth client ID of the Varlikent WEBSITE, from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application).
# It must be the SAME value the frontend builds with as VITE_GOOGLE_CLIENT_ID:
# the browser obtains a Google access token using that client, and the backend
# refuses any token whose `aud` is not on this allowlist. If the two drift
# apart, every Google login fails with "Google authentication failed".
#
# Client IDs are public — the website serves this one to every visitor — so
# this is not a secret. It is configuration because the trusted client differs
# between environments, not because it needs hiding.
GOOGLE_CLIENT_ID=

# Optional. Additional trusted Google OAuth client IDs, comma-separated.
#
# What belongs here is any client ID that legitimately appears as the `aud` of
# a credential Varlikent should accept — for EITHER endpoint shape, since
# /api/auth/google now takes { accessToken } from the website and { idToken }
# from the mobile app and checks both against this same allowlist.
#
# It is NOT simply "the native client IDs". That distinction matters most for
# Android: a native Google sign-in is configured with the WEB/server client ID
# and asks Google for an ID token issued to it, so the `aud` of an Android ID
# token is normally GOOGLE_CLIENT_ID above and nothing needs adding here. The
# Android OAuth client (package name + SHA-1) still has to exist in Google
# Cloud, but it exists so Google can verify the calling app — it is not the
# audience of the credential the backend sees.
#
# So add a value here only after observing the actual `aud` of a real token
# from the client in question. Adding an Android client ID on the assumption
# that an Android app must present it grants trust to a client that never
# appears, while the sign-in keeps failing for the real reason.
#
# Leave unset until such a client actually exists in Google Cloud; a
# placeholder would sit in the allowlist matching nothing.
# GOOGLE_CLIENT_IDS=<another-trusted-client-id>

# OAuth (future)
APPLE_CLIENT_ID=
MS_CLIENT_ID=
